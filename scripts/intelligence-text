#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [ -f "venv/bin/activate" ]; then
  source "venv/bin/activate"
fi

RAW_OUTPUT="$(python3 -m app.process_intelligence_request \
  --definition config/intelligence/default.json \
  "$@")"

RAW_OUTPUT="$RAW_OUTPUT" python3 - <<'PY'
import json
import os

payload = json.loads(os.environ["RAW_OUTPUT"])

print(payload.get("answer", ""))

print()
print(f"status: {payload.get('status')}")
print(f"source: {payload.get('source')}")
print(f"ability: {payload.get('ability')}")
print(f"capability: {payload.get('capability')}")
PY
