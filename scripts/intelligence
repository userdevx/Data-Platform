#!/usr/bin/env bash
set -euo pipefail

ROOT="${DATA_PLATFORM_ROOT:-$HOME/Data-Platform}"
PYTHON_BIN="$ROOT/venv/bin/python3"

cd "$ROOT"

if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="python3"
fi

PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" \
exec "$PYTHON_BIN" -m app.process_intelligence_request "$@"
