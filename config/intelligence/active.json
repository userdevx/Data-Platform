{
  "abilities": {
    "enabled": [
      "identify_instance",
      "report_system_health",
      "answer_record_questions",
      "retrieve_platform_knowledge",
      "model_reasoning",
      "search_public_sources",
      "answer_datetime_questions",
      "manage_memory"
    ]
  },
  "data_engine": {
    "allowed_operations": [
      "query",
      "count",
      "status",
      "search",
      "append_history"
    ],
    "direct_storage_access": false,
    "enabled": true
  },
  "identity": {
    "description": "The default configured intelligence instance for the active application.",
    "display_name": "Paige",
    "id": "default",
    "name": "Intelligence",
    "role": "platform_intelligence"
  },
  "memory": {
    "automatic_recall": true,
    "context_budget": 1500,
    "enabled": true,
    "read": true,
    "source": "data_engine",
    "storage_owner": "data_engine",
    "write": true
  },
  "permissions": {
    "modify_system_files": false,
    "network_access": true,
    "read_records": true,
    "run_approved_commands": false,
    "write_history": true,
    "write_records": false
  },
  "provider": {
    "enabled": true,
    "model": "llama3.2:3b",
    "name": "ollama"
  },
  "response": {
    "include_capability": true,
    "include_data": true,
    "include_instance_name": true,
    "include_role": true,
    "include_source": true,
    "include_status": true
  },
  "routing": {
    "fallback": "controlled_unknown",
    "priority": [
      "identity",
      "system_status",
      "record_query",
      "knowledge_search",
      "public_source_search",
      "datetime",
      "memory_command",
      "model_reasoning"
    ],
    "strategy": "deterministic_first"
  },
  "tools": {
    "enabled": [
      "read_system_status",
      "query_data_engine",
      "search_knowledge",
      "write_intelligence_history",
      "public_source_search"
    ]
  },
  "validation": {
    "blocked_response_phrases": [
      "I can help you with",
      "Hello. I'm",
      "Hello. I’m",
      "No reason returned",
      "unknown source",
      "context_source"
    ],
    "enabled": true,
    "max_answer_chars": 4000,
    "require_answer": true,
    "require_source": true,
    "require_structured_data": true
  },
  "version": "1.0.0"
}
