[Unit]
Description=DataWorc Firecracker Sandbox Guest Agent
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/dataworc/dataworc_firecracker_agent.py
Restart=always
RestartSec=1
User=root
Group=root

# Workloads are children of this agent (systemd-run --scope execs them
# in place), so they inherit this unit's execution settings. Keep only
# settings that are intended for workloads too: no privilege gain via
# setuid binaries. PrivateTmp/ProtectHome are deliberately absent; they
# would hide /root (HOME) and the real /tmp from workloads.
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
