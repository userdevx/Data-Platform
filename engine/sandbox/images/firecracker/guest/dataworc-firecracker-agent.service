[Unit]
Description=DataWorc Firecracker Sandbox Guest Agent
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/dataworc/dataworc_firecracker_agent.py
Restart=always
RestartSec=1
User=root
Group=root

# Workloads run as separate transient units through systemd-run.
# These restrictions therefore constrain the agent, not the workload.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
